    <!-- Contact Picker Feature -->
    <string name="html_feature_contact_picker">Contact Selection via Android Contact Picker</string>
    <string name="html_feature_contact_picker_intro">The app uses the native Android Contact Picker for simple and fast contact selection:</string>
    <string name="html_feature_contact_picker_1">One-click selection via native Android Contact Picker</string>
    <string name="html_feature_contact_picker_2">Persistent encrypted storage of selection</string>
    <string name="html_feature_contact_picker_3">Clear contact card with name, number and type display</string>
    <string name="html_feature_contact_picker_4">Quick change or deactivation of selected contact</string>
    <string name="html_feature_contact_picker_5">Integrated test SMS function directly from contact card</string>
    <string name="html_feature_contact_picker_6">Status query for active forwardings</string>
    <string name="html_feature_contact_picker_7">Central reset of all forwardings</string>

    <!-- SMS Forwarding Feature -->
    <string name="html_feature_sms_forwarding">SMS Forwarding</string>
    <string name="html_feature_sms_forwarding_intro">SMS forwarding offers two independent forwarding paths that you can use individually or combined:</string>
    <string name="html_feature_sms_forwarding_1">SMS-to-SMS: Direct forwarding to a selected phone number</string>
    <string name="html_feature_sms_forwarding_2">SMS-to-Email: Forwarding to any number of email addresses</string>
    <string name="html_feature_sms_forwarding_3">Formatted forwardings with sender and timestamp</string>
    <string name="html_feature_sms_forwarding_4">Test functions for both forwarding paths</string>

    <!-- Email Configuration Feature -->
    <string name="html_feature_email_config">Email Configuration</string>
    <string name="html_feature_email_config_intro">Email forwarding offers extensive configuration options:</string>
    <string name="html_feature_email_config_1">Support for various email providers (Gmail, custom SMTP servers)</string>
    <string name="html_feature_email_config_2">Encrypted storage of credentials</string>
    <string name="html_feature_email_config_3">Individual test emails to each configured address</string>
    <string name="html_feature_email_config_4">Detailed error diagnosis for delivery problems</string>

    <!-- SIM Selection Feature -->
    <string name="html_feature_sim_selection">SIM Card Selection (Dual-SIM Support)</string>
    <string name="html_feature_sim_selection_intro">For devices with multiple SIM cards, the app offers comprehensive management options:</string>
    <string name="html_feature_sim_selection_1">Automatic detection of all available SIM cards</string>
    <string name="html_feature_sim_selection_2">Flexible SIM selection for SMS forwarding (Automatic, SIM 1, SIM 2)</string>
    <string name="html_feature_sim_selection_3">Clear display of SIM card details (provider, phone number)</string>
    <string name="html_feature_sim_selection_4">Individual configuration for each SIM card</string>

    <!-- Call Forwarding Feature -->
    <string name="html_feature_call_forwarding">Call Forwarding</string>
    <string name="html_feature_call_forwarding_intro">Call forwarding uses the native phone function of your device:</string>
    <string name="html_feature_call_forwarding_1">Automatic forwarding of all incoming calls</string>
    <string name="html_feature_call_forwarding_2">Use of MMI/USSD codes for maximum compatibility</string>
    <string name="html_feature_call_forwarding_3">Simultaneous activation with SMS forwarding</string>
    <string name="html_feature_call_forwarding_4">Status display of active forwarding</string>

    <!-- MMI Code Settings Feature -->
    <string name="html_feature_mmi_codes">MMI Code Settings</string>
    <string name="html_feature_mmi_codes_intro">Advanced configuration for mobile network forwardings via MMI codes:</string>
    <string name="html_feature_mmi_codes_1">Configurable MMI/USSD codes for call forwarding</string>
    <string name="html_feature_mmi_codes_2">Network-specific adjustments (Standard, Telekom, Vodafone, etc.)</string>
    <string name="html_feature_mmi_codes_3">Status queries for active network forwardings</string>
    <string name="html_feature_mmi_codes_4">Automatic reset of all forwardings</string>

    <!-- Test and Monitoring Feature -->
    <string name="html_feature_testing">Test and Monitoring</string>
    <string name="html_feature_testing_intro">Comprehensive test and monitoring functions for all forwardings:</string>
    <string name="html_feature_testing_1">Test SMS with customizable content</string>
    <string name="html_feature_testing_2">Separate test emails to individual addresses</string>
    <string name="html_feature_testing_3">Detailed logging of all activities</string>
    <string name="html_feature_testing_4">Export of logs in CSV format</string>

    <!-- User Interface Feature -->
    <string name="html_feature_ui">User Interface</string>
    <string name="html_feature_ui_intro">The user interface has been optimized for intuitive operation:</string>
