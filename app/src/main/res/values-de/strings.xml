    <string name="privacy_perm_battery_body_en">Required for reliable background operation.</string>

    <!-- Foreground Service Permission -->
    <string name="privacy_perm_foreground_de">Vordergrunddienst</string>
    <string name="privacy_perm_foreground_en">Foreground Service</string>
