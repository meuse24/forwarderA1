    <string name="privacy_perm_contacts_body_de">Ermöglicht die Auswahl eines Kontakts für die Weiterleitung.</string>
    <string name="privacy_perm_contacts_body_en">Allows you to select a contact for forwarding.</string>

    <!-- Phone Permission -->
    <string name="privacy_perm_phone_de">Telefon</string>
    <string name="privacy_perm_phone_en">Phone</string>
    <string name="privacy_perm_phone_body_de">Benötigt für Anrufweiterleitung (MMI-Codes) und SIM-Kartenverwaltung.</string>
    <string name="privacy_perm_phone_body_en">Required for call forwarding (MMI codes) and SIM card management.</string>

