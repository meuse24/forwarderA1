    <string name="privacy_perm_foreground_body_en">Allows the app to run in the background and forward SMS.</string>

    <!-- Security Section -->
    <string name="privacy_section_security_title_de">Datensicherheit</string>
    <string name="privacy_section_security_title_en">Data Security</string>
    <string name="privacy_section_security_body_de">Alle Einstellungen und sensiblen Daten werden verschlüsselt auf Ihrem Gerät gespeichert. Es werden keine Daten an externe Server übertragen.</string>
    <string name="privacy_section_security_body_en">All settings and sensitive data are stored encrypted on your device. No data is transmitted to external servers.</string>

