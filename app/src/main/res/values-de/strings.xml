    <string name="privacy_section_email_title_en">Email Forwarding</string>
    <string name="privacy_section_email_body_de">Wenn Sie die E-Mail-Weiterleitung aktivieren, werden Ihre SMTP-Zugangsdaten verschlüsselt gespeichert und nur zum Versenden von SMS-Weiterleitungen verwendet.</string>
    <string name="privacy_section_email_body_en">If you enable email forwarding, your SMTP credentials are stored encrypted and used only for sending SMS forwards.</string>

