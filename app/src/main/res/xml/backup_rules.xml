<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for SMS Forwarder Neo
   SECURITY: Excludes encrypted preferences from backup to prevent exposure
   See https://developer.android.com/guide/topics/data/autobackup
   Note: This file is ignored for devices older than API 31
-->
<full-backup-content>
    <!-- Exclude encrypted SharedPreferences (contains sensitive data) -->
    <exclude domain="sharedpref" path="sms_forwarder_secure_prefs.xml"/>

    <!-- Exclude all logs (may contain sensitive SMS content) -->
    <exclude domain="file" path="logs"/>

    <!-- Include non-sensitive app data -->
    <include domain="sharedpref" path="."/>
</full-backup-content>