<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
       Nur verschluesselte Verbindungen, System-Trust-Anchors.

       Hinweis: Diese Datei steuert die Plattform-HTTP-Stacks. Der SMTP-Versand laeuft ueber die
       rohen Sockets von JavaMail und wird hiervon **nicht** erfasst - erzwungen wird er dort in
       EmailSender (STARTTLS required bzw. TLS ab dem ersten Byte, TLS 1.2+, Hostname-Pruefung).
       Frueher standen hier Cleartext-Ausnahmen fuer drei Mailserver; sie waren wirkungslos und
       suggerierten eine Steuerung, die es nicht gibt.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
