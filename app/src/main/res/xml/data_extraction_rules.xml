<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for SMS Forwarder Neo (Android 12+)
   SECURITY: Excludes encrypted preferences from cloud backup & device transfer
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted SharedPreferences (contains sensitive data) -->
        <exclude domain="sharedpref" path="sms_forwarder_secure_prefs.xml"/>

        <!-- Weiterleitungs-Queue: enthaelt SMS-Volltexte -->
        <exclude domain="sharedpref" path="sms_forwarder_queue.xml"/>

        <!-- E-Mail-Queue: enthaelt ebenfalls SMS-Volltexte samt Empfaengeradressen -->
        <exclude domain="sharedpref" path="sms_forwarder_email_queue.xml"/>

        <!-- Exclude all logs (may contain sensitive SMS content) -->
        <exclude domain="file" path="logs"/>

        <!-- Include non-sensitive app data -->
        <include domain="sharedpref" path="."/>
    </cloud-backup>

    <device-transfer>
        <!-- Same exclusions for device-to-device transfer -->
        <exclude domain="sharedpref" path="sms_forwarder_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="sms_forwarder_queue.xml"/>
        <exclude domain="sharedpref" path="sms_forwarder_email_queue.xml"/>
        <exclude domain="file" path="logs"/>
        <include domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>